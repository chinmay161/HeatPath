# Physical devices need your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Google Maps SDK for Android
GOOGLE_MAPS_API_KEY=

# Auth0 Authentication Settings
# Your Auth0 tenant domain (e.g. dev-xyz.us.auth0.com)
EXPO_PUBLIC_AUTH0_DOMAIN=
# Your Auth0 Native Application Client ID
EXPO_PUBLIC_AUTH0_CLIENT_ID=
# Your Auth0 API Identifier (Audience) - matches AUTH0_AUDIENCE in backend
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.heatpath.com
