PORT=8000
ENV=development
API_KEY_PLACEHOLDER=your_api_key_here
POSTGIS_DSN=postgresql://heatpath_app:PASSWORD@127.0.0.1:5433/heatpath_osm

# Redis Cache Settings
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=21600
CACHE_NAMESPACE=heatpath

# Auth0 Authentication Settings
# Your Auth0 tenant domain (e.g. dev-xyz.us.auth0.com)
AUTH0_DOMAIN=
# Your Auth0 API Identifier (Audience) defined in Auth0 Dashboard -> Applications -> APIs
AUTH0_AUDIENCE=https://api.heatpath.com
# Auth0 Issuer URL (defaults to https://{AUTH0_DOMAIN}/ if omitted)
AUTH0_ISSUER=
# Signature verification algorithms (defaults to RS256)
AUTH0_ALGORITHMS=RS256
